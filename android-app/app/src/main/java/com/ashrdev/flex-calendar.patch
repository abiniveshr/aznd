+        val natW = nw + 2 * pad
+        val natH = head + nh + 2 * pad
+        val ratio = natW / natH
+        return Size(natW, natH, (lw + 2 * pad) * k, (head + lh + 2 * pad) * k, ratio * 0.7f, ratio * 1.6f)
