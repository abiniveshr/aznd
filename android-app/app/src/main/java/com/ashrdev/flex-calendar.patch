+     * (it multiplies the least size, as a chart's does).
+     */
+    fun of(zoom: CalendarZoom, pad: Float, head: Float, weekdays: Boolean, k: Float): Size {
+        val (nw, nh) = grid(zoom, naturalCell(zoom), weekdays)
